# Copy the Session pooler URI from Supabase Connect and URL-encode the password.
# For local Node, replace sslrootcert with the URL-encoded absolute CA file path.
# Docker overrides sslrootcert with the mounted DB_SSL_CA_FILE automatically.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=ABSOLUTE_CA_PATH
DB_SSL=true
HOST=127.0.0.1
PORT=8000
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Generate independent random secrets (at least 32 characters). Never use these comments as values.
JWT_ACCESS_SECRET=
QR_SECRET=
PAYMENT_MODE=disabled
# Gmail + VNPay sandbox: see docs/EMAIL-PAYMENT-SETUP.md
PUBLIC_API_URL=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Server public outbound IP for querydr, if required by your sandbox merchant.
VNPAY_QUERY_IP=127.0.0.1
# Local demo only: set PAYMENT_MODE=demo and choose a 12+ character seed password.
DEMO_PASSWORD=
SMTP_HOST=
# Gmail: smtp.gmail.com / 587 / false (STARTTLS is mandatory)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SePay Live: configure only in the ignored server/.env file.
SEPAY_ENABLED=false
SEPAY_ACCEPT_NEW_PAYMENTS=false
SEPAY_ENV=live
SEPAY_CREDENTIAL_ENV=live
SEPAY_BANK_CODE=MBBank
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_SECRET=
SEPAY_API_V2_TOKEN=
SEPAY_DB_TARGET=
SEPAY_WORKER_POLL_MS=2000
SEPAY_WORKER_BATCH=10
SEPAY_RECONCILE_MS=60000
SEPAY_LOOKBACK_MINUTES=60
