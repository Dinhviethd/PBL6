DATABASE_URL=postgresql://postgres:localdev@127.0.0.1:55436/eventhub
DB_SSL=false
HOST=127.0.0.1
PORT=8000
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Generate independent random secrets (at least 32 characters). Never use these comments as values.
JWT_ACCESS_SECRET=
QR_SECRET=
PAYMENT_MODE=disabled
# Gmail + VNPay sandbox: see docs/EMAIL-PAYMENT-SETUP.md
PUBLIC_API_URL=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Server public outbound IP for querydr, if required by your sandbox merchant.
VNPAY_QUERY_IP=127.0.0.1
# Local demo only: set PAYMENT_MODE=demo and choose a 12+ character seed password.
DEMO_PASSWORD=
SMTP_HOST=
# Gmail: smtp.gmail.com / 587 / false (STARTTLS is mandatory)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
