# Deprecated template: Live runtime now loads server/.env only. Do not add or maintain a second runtime configuration here.
# Template only: never insert real credentials into this tracked file.
# Load values into the API and worker environment before launching from server/.
# Remains disabled until configured deliberately after the migration gate.
SEPAY_ENABLED=false
SEPAY_ACCEPT_NEW_PAYMENTS=true
SEPAY_ENV=live
SEPAY_CREDENTIAL_ENV=live
PAYMENT_MODE=disabled
NODE_ENV=production
SEPAY_BANK_CODE=MBBank
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_SECRET=
SEPAY_API_V2_TOKEN=
DATABASE_URL=
# Exact hostname:port/database matching DATABASE_URL (no username or password).
SEPAY_DB_TARGET=
DB_SSL=true
DB_SSL_CA_FILE=./.local/certs/supabase-ca.crt
JWT_ACCESS_SECRET=
QR_SECRET=
CLIENT_URL=
HOST=127.0.0.1
PORT=8011
SEPAY_WORKER_POLL_MS=2000
SEPAY_WORKER_BATCH=10
SEPAY_RECONCILE_MS=60000
SEPAY_LOOKBACK_MINUTES=60
