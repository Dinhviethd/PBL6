{
  "name": "backend_api",
  "version": "1.0.0",
  "main": "main.ts",
  "scripts": {
    "dev": "nodemon --watch ./src --ext ts --exec ts-node -r tsconfig-paths/register src/main.ts",
    "build": "tsc && tsc-alias && node scripts/copy-schema.cjs",
    "test": "node --test test/*.test.cjs",
    "migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d src/configs/database.config.ts",
    "migration:run": "node scripts/migrate.cjs",
    "migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/configs/database.config.ts",
    "migration:show": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:show -d src/configs/database.config.ts",
    "seed": "node scripts/seed.cjs",
    "start": "node dist/main.js",
    "check:boundaries": "node scripts/check-boundaries.cjs",
    "db:migrate": "npm run build && node scripts/migrate.cjs",
    "db:seed": "node scripts/seed.cjs",
    "jobs:expire": "node scripts/expire.cjs",
    "jobs:watch": "node scripts/worker.cjs"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@types/ws": "^8.18.1",
    "@upstash/redis": "^1.37.0",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "firebase-admin": "^13.8.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "mysql2": "^3.14.3",
    "nodemailer": "^7.0.12",
    "nsfwjs": "^4.2.1",
    "pg": "^8.16.3",
    "pgsql-ast-parser": "^12.0.2",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.26",
    "zod": "^4.1.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.3",
    "@types/nodemailer": "^7.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/sharp": "^0.31.1",
    "nodemon": "^3.1.10",
    "prettier": "^3.9.9",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.2"
  }
}
